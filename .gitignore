# This repository publishes only the topology-optimisation library aerokit.topo (whitelist).
/*
!/.gitignore
!/README.md
!/LICENSE
!/pyproject.toml
!/docs/
!/examples/
!/src/
!/tests/

/src/aerokit/*
!/src/aerokit/__init__.py
!/src/aerokit/py.typed
!/src/aerokit/references/
!/src/aerokit/topo/
/src/aerokit/references/*
!/src/aerokit/references/__init__.py
!/src/aerokit/references/_core.py
!/src/aerokit/references/_aero.py
!/src/aerokit/references/_structures.py
!/src/aerokit/references/_composites.py
!/src/aerokit/references/_fem.py
!/src/aerokit/references/_fem_dynamics.py
!/src/aerokit/references/_optimization.py
!/src/aerokit/references/_cad.py
!/src/aerokit/references/_materials.py

/tests/*
!/tests/topo/

/docs/*
!/docs/mimari_plan.md
!/docs/registry.md
!/docs/olcumler/

__pycache__/
*.pyc
.pytest_cache/
runs/
*.pkl
*.npy
*.npz
