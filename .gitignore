# This repository publishes only the topology-optimisation library aerokit.topo (whitelist).
/*
!/.gitignore
!/README.md
!/LICENSE
!/pyproject.toml
!/docs/
!/examples/
!/src/
!/tests/

/src/aerokit/*
!/src/aerokit/__init__.py
!/src/aerokit/py.typed
!/src/aerokit/references/
!/src/aerokit/topo/
/src/aerokit/references/_ideathon2026.py
/src/aerokit/references/_task_*.py

/tests/*
!/tests/topo/

/docs/*
!/docs/mimari_plan.md
!/docs/registry.md
!/docs/olcumler/

__pycache__/
*.pyc
.pytest_cache/
runs/
*.pkl
*.npy
*.npz
